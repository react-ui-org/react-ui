# EditorConfig helps developers define and maintain consistent
# coding styles between different editors and IDEs.
# editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{css,scss,md}]
indent_size = 4

[*.{cpp,hpp}]
indent_size = 4

[*.py]
indent_size = 4

[Makefile]
indent_style = tab
